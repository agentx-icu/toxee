# Deploy only release CRTs from the selected MSVC toolchain, never System32.
# ARM64 redist includes ARM64X DLLs and an EC-only vcruntime140_1.dll.
# The latter is not a native-ARM64 dependency and must not enter that package.
set(TOXEE_MSVC_RUNTIME_POLICY "${CMAKE_CURRENT_LIST_DIR}/../../tool/ci/windows_runtime_files.txt")
function(toxee_install_msvc_files destination architecture)
  string(TOLOWER "${architecture}" arch)
  if(NOT arch MATCHES "^(x64|arm64)$")
    message(FATAL_ERROR "Unsupported MSVC runtime architecture: ${architecture}")
  endif()
  file(STRINGS "${TOXEE_MSVC_RUNTIME_POLICY}" allowed)
  set(selected "")
  set(names "")
  foreach(path IN LISTS ARGN)
    get_filename_component(name "${path}" NAME)
    string(TOLOWER "${name}" name)
    if(NOT name IN_LIST allowed)
      message(FATAL_ERROR "Unreviewed MSVC runtime file: ${path}")
    endif()
    if(NOT EXISTS "${path}")
      message(FATAL_ERROR "Missing MSVC redistributable: ${path}")
    endif()
    file(READ "${path}" dos OFFSET 0 LIMIT 2 HEX)
    file(READ "${path}" offset OFFSET 60 LIMIT 4 HEX)
    if(NOT dos STREQUAL "4d5a" OR NOT offset MATCHES "^[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]$")
      message(FATAL_ERROR "Invalid MSVC runtime DOS header: ${path}")
    endif()
    string(SUBSTRING "${offset}" 0 2 b0)
    string(SUBSTRING "${offset}" 2 2 b1)
    string(SUBSTRING "${offset}" 4 2 b2)
    string(SUBSTRING "${offset}" 6 2 b3)
    math(EXPR pe "0x${b3}${b2}${b1}${b0}")
    file(READ "${path}" header OFFSET ${pe} LIMIT 6 HEX)
    if(NOT pe GREATER_EQUAL 64 OR NOT header MATCHES "^50450000[0-9a-f][0-9a-f][0-9a-f][0-9a-f]$")
      message(FATAL_ERROR "Invalid MSVC runtime PE header: ${path}")
    endif()
    string(SUBSTRING "${header}" 8 4 machine)
    if(arch STREQUAL "arm64" AND name STREQUAL "vcruntime140_1.dll" AND machine MATCHES "^(6486|41a6)$")
      message(STATUS "Excluding EC-only ${name} from the native ARM64 bundle")
      continue()
    endif()
    if((arch STREQUAL "x64" AND NOT machine STREQUAL "6486") OR
       (arch STREQUAL "arm64" AND NOT machine STREQUAL "64aa"))
      message(FATAL_ERROR "MSVC runtime CPU mismatch: ${name}, ${machine}, target ${arch}")
    endif()
    if(name IN_LIST names)
      message(FATAL_ERROR "Ambiguous MSVC runtime selection: ${name}")
    endif()
    list(APPEND names "${name}")
    list(APPEND selected "${path}")
  endforeach()
  set(required msvcp140.dll vcruntime140.dll msvcp140_atomic_wait.dll)
  if(arch STREQUAL "x64")
    list(APPEND required vcruntime140_1.dll)
  endif()
  foreach(name IN LISTS required)
    if(NOT name IN_LIST names)
      message(FATAL_ERROR "Missing required app-local MSVC runtime: ${name}")
    endif()
  endforeach()
  install(FILES ${selected} DESTINATION "${destination}" CONFIGURATIONS Profile Release COMPONENT Runtime)
  list(JOIN names "\n" inventory)
  set(notice "${CMAKE_CURRENT_BINARY_DIR}/MICROSOFT_RUNTIME_NOTICE.txt")
  file(WRITE "${notice}" "Microsoft Visual C++ release runtime (unmodified vendor binaries)\nTarget: ${arch}\nCompiler: ${CMAKE_CXX_COMPILER_VERSION}\n\n${inventory}\n\nRedistribution is subject to the applicable Visual Studio license terms. The release owner must confirm redistribution rights and retain the applicable terms.\nhttps://learn.microsoft.com/en-us/cpp/windows/redistributing-visual-cpp-files\nhttps://learn.microsoft.com/en-us/visualstudio/releases/2022/redistribution\nhttps://learn.microsoft.com/en-us/visualstudio/releases/2026/redistribution\nWindows 10/11 supplies the Universal CRT; it is not copied from this build host.\n")
  install(FILES "${notice}" DESTINATION "${destination}" CONFIGURATIONS Profile Release COMPONENT Runtime)
endfunction()

function(toxee_install_msvc_runtime destination)
  string(TOLOWER "${MSVC_CXX_ARCHITECTURE_ID}" arch)
  if(NOT arch)
    string(TOLOWER "${MSVC_C_ARCHITECTURE_ID}" arch)
  endif()
  # vcvars selects a redist version alongside the compiler. Require one CRT
  # directory for this target; do not pick another version or the host CPU.
  file(TO_CMAKE_PATH "$ENV{VCToolsRedistDir}" redist)
  if(redist)
    file(GLOB directories LIST_DIRECTORIES true "${redist}/${arch}/Microsoft.VC*.CRT")
    list(LENGTH directories count)
    if(NOT count EQUAL 1)
      message(FATAL_ERROR "Expected one ${arch} CRT directory in the selected VCToolsRedistDir")
    endif()
    list(GET directories 0 directory)
    # The redist directory also contains optional C++/CX components. Select
    # the reviewed CRT set instead of copying every redistributable feature.
    file(STRINGS "${TOXEE_MSVC_RUNTIME_POLICY}" reviewed)
    set(libraries "")
    foreach(name IN LISTS reviewed)
      if(EXISTS "${directory}/${name}")
        list(APPEND libraries "${directory}/${name}")
      endif()
    endforeach()
  else()
    set(CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS_SKIP TRUE)
    set(CMAKE_INSTALL_DEBUG_LIBRARIES FALSE)
    set(CMAKE_INSTALL_DEBUG_LIBRARIES_ONLY FALSE)
    set(CMAKE_INSTALL_UCRT_LIBRARIES FALSE)
    include(InstallRequiredSystemLibraries)
    set(libraries ${CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS})
  endif()
  toxee_install_msvc_files("${destination}" "${arch}" ${libraries})
endfunction()
