+  ({int status, int generation}) configureLogOwned(String absolutePath) {
+    if (absolutePath.contains('\u0000')) return (status: 2, generation: 0);
+    final path = absolutePath.toNativeUtf8();
+    final generation = pkgffi.calloc<ffi.Uint64>();
