diff --git a/source/BoundedLogSink.h b/source/BoundedLogSink.h
new file mode 100644
index 0000000..6c79a88
--- /dev/null
+++ b/source/BoundedLogSink.h
@@ -0,0 +1,473 @@
+#ifndef TIM2TOX_BOUNDED_LOG_SINK_H
+#define TIM2TOX_BOUNDED_LOG_SINK_H
+
+#include <algorithm>
+#include <array>
+#include <cerrno>
+#include <cstdint>
+#include <filesystem>
+#include <limits>
+#include <regex>
+#include <string>
+#include <vector>
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#else
+#include <dirent.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <sys/file.h>
+#include <unistd.h>
+#ifdef __APPLE__
+#include <sys/param.h>
+#endif
+#endif
+
+namespace tim2tox::diag {
+
+// Stable C ABI status values. A caller must never infer ownership from an
+// exception, INVALID, UNSAFE_PATH, BUSY or NOT_OWNER.
+enum class SinkStatus : int32_t {
+    Ok = 0, Truncated = 1, Invalid = 2, UnsafePath = 3,
+    IoNoOwner = 4, NotOwner = 5, IoPartialReleased = 6,
+    Busy = 7, InternalUncertain = 8,
+};
+
+// Called exclusively under V2TIMLog's mutex. This is the sole file owner for
+// both typed native records and already-sanitized application records. No
+// callback, queue, configurable production budget, or recursive logging.
+class BoundedLogSink {
+public:
+    static constexpr uint64_t kSegmentBytes = 10 * 1024 * 1024;
+    static constexpr size_t kFileCount = 10;
+    static constexpr size_t kRecordBytes = 64 * 1024;
+    ~BoundedLogSink() { close(); }
+
+    static SinkStatus validatePath(const std::string& path) {
+        const auto p = utf8Path(path);
+        return path.empty() || path.find('\0') != std::string::npos ||
+            !p.is_absolute() || p.filename().empty() || familyRoot(utf8(p.stem())).empty() || p.lexically_normal() != p ?
+            SinkStatus::Invalid : SinkStatus::Ok;
+    }
+
+    SinkStatus configure(const std::string& path) {
+        const auto valid = validatePath(path);
+        if (valid != SinkStatus::Ok) return valid;
+        const auto p = utf8Path(path);
+        name_ = utf8(p.filename());
+        parent_ = p.parent_path();
+        // Numeric suffixes are rotation/session variants of one family.
+        // This partitions names: app.log/app_123.log and foo.log/foo_1.log
+        // cannot have overlapping ledgers protected by different locks.
+        const auto root = familyRoot(utf8(p.stem()));
+        const auto extension = utf8(p.extension());
+        lock_name_ = "." + root + extension + ".sink-lock";
+        family_ = std::regex(escape(root) + "(_[0-9]+)*" + escape(extension));
+        auto status = openDirectory();
+        if (status != SinkStatus::Ok) { return failedConfigure(status); }
+        status = openLedgerLock();
+        if (status != SinkStatus::Ok) return failedConfigure(status);
+        std::vector<Entry> entries;
+        status = inventory(entries);
+        if (status != SinkStatus::Ok) { return failedConfigure(status); }
+        // Validate every candidate before deleting/trimming anything. A link
+        // anywhere in the recognized ledger makes the entire handoff unsafe.
+        status = prune(entries, kFileCount - (contains(entries, name_) ? 0 : 1));
+        if (status != SinkStatus::Ok) { return failedConfigure(status); }
+        const auto active = name_;
+        for (const auto& entry : entries) {
+            if (entry.size <= kSegmentBytes || entry.name == active) continue;
+            name_ = entry.name;
+            status = openActive();
+            if (status == SinkStatus::Ok) status = trimLegacy();
+            if (status != SinkStatus::Ok || !closeActive()) { return failedConfigure(status == SinkStatus::Ok ? SinkStatus::InternalUncertain : status); }
+        }
+        name_ = active;
+        status = openActive();
+        if (status == SinkStatus::Ok) status = trimLegacy();
+        if (status != SinkStatus::Ok) { return failedConfigure(status); }
+        return SinkStatus::Ok;
+    }
+
+    SinkStatus append(const uint8_t* data, size_t length) {
+        if (!data || !length) return SinkStatus::Invalid;
+        // Native typed records and Dart's UTF-8 encoder produce valid UTF-8.
+        // Validate the C ABI input before persisting or altering ownership.
+        std::string record;
+        bool truncated = length > kRecordBytes;
+        if (truncated) {
+            size_t keep = kRecordBytes - 96;
+            while (keep && (data[keep] & 0xc0) == 0x80) --keep;
+            if (!validUtf8(data, keep)) return SinkStatus::Invalid;
+            record.assign(reinterpret_cast<const char*>(data), keep);
+            record += "\n[WARN] component=logger event=record_truncated omitted_bytes=" +
+                      std::to_string(length - keep) + "\n";
+        } else {
+            if (!validUtf8(data, length)) return SinkStatus::Invalid;
+            record.assign(reinterpret_cast<const char*>(data), length);
+        }
+        if (!activeValid()) return failReleased(SinkStatus::IoPartialReleased);
+        if (size_ > kSegmentBytes) {
+            const auto trimmed = trimLegacy();
+            if (trimmed != SinkStatus::Ok) return failReleased(trimmed);
+        }
+        if (size_ + record.size() > kSegmentBytes) {
+            auto status = rotate();
+            if (status != SinkStatus::Ok) return failReleased(status);
+        }
+        if (!writeAt(reinterpret_cast<const uint8_t*>(record.data()), record.size(), size_))
+            return failReleased(SinkStatus::IoPartialReleased);
+        size_ += record.size();
+        return truncated ? SinkStatus::Truncated : SinkStatus::Ok;
+    }
+
+    SinkStatus close() {
+        bool ok = closeActive();
+#ifdef _WIN32
+        if (ledger_lock_ != INVALID_HANDLE_VALUE) {
+            const auto handle = ledger_lock_; ledger_lock_ = INVALID_HANDLE_VALUE;
+            ok = CloseHandle(handle) && ok;
+        }
+        for (auto handle : directories_) ok = CloseHandle(handle) && ok;
+        directories_.clear();
+#else
+        if (ledger_lock_ >= 0) { const auto fd = ledger_lock_; ledger_lock_ = -1; ok = (::close(fd) == 0) && ok; }
+        if (directory_ >= 0) { const auto fd = directory_; directory_ = -1; ok = (::close(fd) == 0) && ok; }
+#endif
+        return ok ? SinkStatus::Ok : SinkStatus::InternalUncertain;
+    }
+
+private:
+    struct Entry { std::string name; uint64_t size; int64_t time; };
+    std::filesystem::path parent_;
+    std::string name_, lock_name_;
+    std::regex family_;
+    uint64_t size_ = 0;
+#ifdef _WIN32
+    HANDLE file_ = INVALID_HANDLE_VALUE, ledger_lock_ = INVALID_HANDLE_VALUE;
+    std::vector<HANDLE> directories_;
+    BY_HANDLE_FILE_INFORMATION identity_{};
+#else
+    int file_ = -1, directory_ = -1, ledger_lock_ = -1;
+    struct stat identity_{};
+#endif
+
+    static std::string familyRoot(const std::string& stem) {
+        size_t end = stem.size();
+        for (;;) {
+            size_t digits = end;
+            while (digits && stem[digits - 1] >= '0' && stem[digits - 1] <= '9') --digits;
+            if (digits == end || !digits || stem[digits - 1] != '_') break;
+            end = digits - 1;
+        }
+        return stem.substr(0, end);
+    }
+    static std::string utf8(const std::filesystem::path& path) {
+        const auto bytes = path.u8string();
+        return std::string(bytes.begin(), bytes.end());
+    }
+    static std::filesystem::path utf8Path(const std::string& value) {
+        return std::filesystem::path(std::u8string(value.begin(), value.end()));
+    }
+    static std::string escape(const std::string& value) {
+        return std::regex_replace(value, std::regex(R"([.^$|()\[\]{}*+?\\])"), R"(\$&)");
+    }
+    static bool contains(const std::vector<Entry>& entries, const std::string& name) {
+        return std::any_of(entries.begin(), entries.end(), [&](const auto& e) { return e.name == name; });
+    }
+    static bool validUtf8(const uint8_t* p, size_t n) {
+        for (size_t i = 0; i < n;) {
+            uint32_t cp = p[i++]; size_t following = 0;
+            if (cp < 0x80) continue;
+            if (cp >= 0xc2 && cp <= 0xdf) { cp &= 0x1f; following = 1; }
+            else if (cp >= 0xe0 && cp <= 0xef) { cp &= 0x0f; following = 2; }
+            else if (cp >= 0xf0 && cp <= 0xf4) { cp &= 7; following = 3; }
+            else return false;
+            if (i + following > n) return false;
+            for (size_t j = 0; j < following; ++j) {
+                if ((p[i] & 0xc0) != 0x80) return false;
+                cp = (cp << 6) | (p[i++] & 0x3f);
+            }
+            if ((following == 1 && cp < 0x80) || (following == 2 && cp < 0x800) ||
+                (following == 3 && cp < 0x10000) || cp > 0x10ffff || (cp >= 0xd800 && cp <= 0xdfff)) return false;
+        }
+        return true;
+    }
+    SinkStatus openDirectory() {
+#ifdef _WIN32
+        auto part = parent_.root_path();
+        if (part.empty()) return SinkStatus::Invalid;
+        for (const auto& component : parent_.relative_path()) {
+            part /= component;
+            HANDLE handle = CreateFileW(part.c_str(), FILE_READ_ATTRIBUTES,
+                FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_EXISTING,
+                FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+            if (handle == INVALID_HANDLE_VALUE) return SinkStatus::IoNoOwner;
+            directories_.push_back(handle);
+            BY_HANDLE_FILE_INFORMATION info{};
+            if (!GetFileInformationByHandle(handle, &info) ||
+                (info.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) ||
+                !(info.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)) return SinkStatus::UnsafePath;
+        }
+#elif defined(__APPLE__)
+        // O_SEARCH is absent on supported older Darwin kernels; O_EVTONLY
+        // still requires read access. Open only the readable ledger directory,
+        // then prove this held vnode is the caller-canonical physical parent
+        // before creating a lock, pruning or writing. Never reopen by path.
+        directory_ = ::open(parent_.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+        if (directory_ < 0) return errno == ELOOP || errno == ENOTDIR ? SinkStatus::UnsafePath : SinkStatus::IoNoOwner;
+        std::array<char, MAXPATHLEN> physical{};
+        if (::fcntl(directory_, F_GETPATH, physical.data()) != 0 ||
+            std::find(physical.begin(), physical.end(), '\0') == physical.end()) return SinkStatus::IoNoOwner;
+        if (utf8Path(physical.data()) != parent_) return SinkStatus::UnsafePath;
+#else
+#ifdef __linux__
+        constexpr int searchAccess = O_PATH;
+#else
+        constexpr int searchAccess = O_RDONLY;
+#endif
+        const auto relative = parent_.relative_path();
+        directory_ = ::open("/", (relative.empty() ? O_RDONLY : searchAccess) | O_DIRECTORY | O_CLOEXEC);
+        if (directory_ < 0) return SinkStatus::IoNoOwner;
+        for (auto component = relative.begin(); component != relative.end(); ++component) {
+            auto following = component; ++following;
+            const auto access = following == relative.end() ? O_RDONLY : searchAccess;
+            int next = ::openat(directory_, component->c_str(), access | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+            if (next < 0) return errno == ELOOP || errno == ENOTDIR ? SinkStatus::UnsafePath : SinkStatus::IoNoOwner;
+            ::close(directory_); directory_ = next;
+        }
+#endif
+        return SinkStatus::Ok;
+    }
+    SinkStatus openLedgerLock() {
+        // A zero-byte family lock prevents two cooperating app processes from
+        // pruning an active session belonging to the other owner. It stores no
+        // diagnostic data and is never removed/replaced while held.
+#ifdef _WIN32
+        ledger_lock_ = CreateFileW((parent_ / utf8Path(lock_name_)).c_str(), GENERIC_READ | GENERIC_WRITE,
+            FILE_SHARE_READ, nullptr, OPEN_ALWAYS, FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+        if (ledger_lock_ == INVALID_HANDLE_VALUE) return GetLastError() == ERROR_SHARING_VIOLATION ? SinkStatus::Busy : SinkStatus::IoNoOwner;
+        BY_HANDLE_FILE_INFORMATION info{};
+        if (!GetFileInformationByHandle(ledger_lock_, &info) || info.nNumberOfLinks != 1 ||
+            info.nFileSizeHigh || info.nFileSizeLow ||
+            (info.dwFileAttributes & (FILE_ATTRIBUTE_REPARSE_POINT | FILE_ATTRIBUTE_DIRECTORY))) return SinkStatus::UnsafePath;
+#else
+        ledger_lock_ = ::openat(directory_, lock_name_.c_str(), O_RDWR | O_CREAT | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK, 0600);
+        if (ledger_lock_ < 0) return errno == ELOOP ? SinkStatus::UnsafePath : SinkStatus::IoNoOwner;
+        struct stat info{};
+        if (::fstat(ledger_lock_, &info) || !S_ISREG(info.st_mode) || info.st_nlink != 1 || info.st_size) return SinkStatus::UnsafePath;
+        if (::flock(ledger_lock_, LOCK_EX | LOCK_NB)) return errno == EAGAIN || errno == EWOULDBLOCK ? SinkStatus::Busy : SinkStatus::IoNoOwner;
+#endif
+        return SinkStatus::Ok;
+    }
+    SinkStatus inspect(const std::string& name, Entry& entry) {
+#ifdef _WIN32
+        HANDLE h = CreateFileW((parent_ / utf8Path(name)).c_str(), FILE_READ_ATTRIBUTES,
+            FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_EXISTING, FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+        if (h == INVALID_HANDLE_VALUE) return SinkStatus::IoNoOwner;
+        BY_HANDLE_FILE_INFORMATION info{};
+        bool safe = GetFileInformationByHandle(h, &info) && info.nNumberOfLinks == 1 &&
+            !(info.dwFileAttributes & (FILE_ATTRIBUTE_REPARSE_POINT | FILE_ATTRIBUTE_DIRECTORY));
+        CloseHandle(h);
+        if (!safe) return SinkStatus::UnsafePath;
+        entry = {name, (uint64_t(info.nFileSizeHigh) << 32) | info.nFileSizeLow,
+            int64_t((uint64_t(info.ftLastWriteTime.dwHighDateTime) << 32) | info.ftLastWriteTime.dwLowDateTime)};
+#else
+        struct stat s{};
+        if (::fstatat(directory_, name.c_str(), &s, AT_SYMLINK_NOFOLLOW) != 0) return SinkStatus::IoNoOwner;
+        if (!S_ISREG(s.st_mode) || s.st_nlink != 1) return SinkStatus::UnsafePath;
+        entry = {name, uint64_t(s.st_size), int64_t(s.st_mtime)};
+#endif
+        return SinkStatus::Ok;
+    }
+    SinkStatus inventory(std::vector<Entry>& entries) {
+#ifdef _WIN32
+        WIN32_FIND_DATAW data{};
+        HANDLE find = FindFirstFileW((parent_ / L"*").c_str(), &data);
+        if (find == INVALID_HANDLE_VALUE) return SinkStatus::IoNoOwner;
+        SinkStatus status = SinkStatus::Ok;
+        do {
+            auto utf8 = std::filesystem::path(data.cFileName).u8string();
+            std::string name(utf8.begin(), utf8.end());
+            if (!std::regex_match(name, family_)) continue;
+            Entry entry; status = inspect(name, entry);
+            if (status != SinkStatus::Ok) break;
+            entries.push_back(entry);
+        } while (FindNextFileW(find, &data));
+        if (status == SinkStatus::Ok && GetLastError() != ERROR_NO_MORE_FILES) status = SinkStatus::IoNoOwner;
+        if (!FindClose(find) && status == SinkStatus::Ok) status = SinkStatus::IoNoOwner;
+        return status;
+#else
+        int fd = ::openat(directory_, ".", O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+        if (fd < 0) return SinkStatus::IoNoOwner;
+        DIR* dir = ::fdopendir(fd);
+        if (!dir) { ::close(fd); return SinkStatus::IoNoOwner; }
+        SinkStatus status = SinkStatus::Ok;
+        for (;;) {
+            errno = 0;
+            auto item = ::readdir(dir);
+            if (!item) {
+                if (errno) status = SinkStatus::IoNoOwner;
+                break;
+            }
+            std::string name(item->d_name);
+            if (!std::regex_match(name, family_)) continue;
+            Entry entry; status = inspect(name, entry);
+            if (status != SinkStatus::Ok) break;
+            entries.push_back(entry);
+        }
+        if (::closedir(dir) && status == SinkStatus::Ok) status = SinkStatus::IoNoOwner;
+        return status;
+#endif
+    }
+    SinkStatus prune(std::vector<Entry>& entries, size_t maximum) {
+        std::sort(entries.begin(), entries.end(), [](const auto& a, const auto& b) {
+            return a.time != b.time ? a.time < b.time : a.name < b.name;
+        });
+        for (auto it = entries.begin(); entries.size() > maximum && it != entries.end();) {
+            if (it->name == name_) { ++it; continue; }
+            Entry checked;
+            auto status = inspect(it->name, checked);
+            if (status != SinkStatus::Ok) return status;
+#ifdef _WIN32
+            if (!DeleteFileW((parent_ / utf8Path(it->name)).c_str())) return SinkStatus::IoNoOwner;
+#else
+            if (::unlinkat(directory_, it->name.c_str(), 0) != 0) return SinkStatus::IoNoOwner;
+#endif
+            it = entries.erase(it);
+        }
+        return entries.size() <= maximum ? SinkStatus::Ok : SinkStatus::IoNoOwner;
+    }
+    SinkStatus openActive() {
+#ifdef _WIN32
+        file_ = CreateFileW((parent_ / utf8Path(name_)).c_str(), GENERIC_READ | GENERIC_WRITE,
+            FILE_SHARE_READ, nullptr, OPEN_ALWAYS, FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+        if (file_ == INVALID_HANDLE_VALUE) return SinkStatus::IoNoOwner;
+        if (!GetFileInformationByHandle(file_, &identity_) || identity_.nNumberOfLinks != 1 ||
+            (identity_.dwFileAttributes & (FILE_ATTRIBUTE_REPARSE_POINT | FILE_ATTRIBUTE_DIRECTORY))) return SinkStatus::UnsafePath;
+        size_ = (uint64_t(identity_.nFileSizeHigh) << 32) | identity_.nFileSizeLow;
+#else
+        file_ = ::openat(directory_, name_.c_str(), O_RDWR | O_CREAT | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK, 0600);
+        if (file_ < 0) return errno == ELOOP ? SinkStatus::UnsafePath : SinkStatus::IoNoOwner;
+        if (::fstat(file_, &identity_) || !S_ISREG(identity_.st_mode) || identity_.st_nlink != 1) return SinkStatus::UnsafePath;
+        size_ = identity_.st_size;
+#endif
+        return SinkStatus::Ok;
+    }
+    bool activeValid() {
+#ifdef _WIN32
+        BY_HANDLE_FILE_INFORMATION info{};
+        if (file_ == INVALID_HANDLE_VALUE || !GetFileInformationByHandle(file_, &info) || info.nNumberOfLinks != 1) return false;
+        size_ = (uint64_t(info.nFileSizeHigh) << 32) | info.nFileSizeLow;
+        return true;
+#else
+        struct stat fd{}, path{};
+        if (file_ < 0 || ::fstat(file_, &fd) || fd.st_nlink != 1 ||
+            ::fstatat(directory_, name_.c_str(), &path, AT_SYMLINK_NOFOLLOW) ||
+            fd.st_dev != path.st_dev || fd.st_ino != path.st_ino || !S_ISREG(path.st_mode)) return false;
+        size_ = uint64_t(fd.st_size);
+        return true;
+#endif
+    }
+    bool closeActive() {
+#ifdef _WIN32
+        if (file_ == INVALID_HANDLE_VALUE) return true;
+        auto handle = file_; file_ = INVALID_HANDLE_VALUE; return CloseHandle(handle);
+#else
+        if (file_ < 0) return true;
+        auto fd = file_; file_ = -1; return ::close(fd) == 0;
+#endif
+    }
+    bool writeAt(const uint8_t* data, size_t n, uint64_t offset) {
+        while (n) {
+#ifdef _WIN32
+            LARGE_INTEGER position; position.QuadPart = offset;
+            DWORD done = 0;
+            if (!SetFilePointerEx(file_, position, nullptr, FILE_BEGIN) ||
+                !WriteFile(file_, data, DWORD(n), &done, nullptr) || !done) return false;
+#else
+            ssize_t done = ::pwrite(file_, data, n, off_t(offset));
+            if (done < 0 && errno == EINTR) continue;
+            if (done <= 0) return false;
+#endif
+            data += done; n -= done; offset += done;
+        }
+        return true;
+    }
+    bool readAt(uint8_t* data, size_t n, uint64_t offset) {
+#ifdef _WIN32
+        LARGE_INTEGER position; position.QuadPart = offset; DWORD done = 0;
+        return SetFilePointerEx(file_, position, nullptr, FILE_BEGIN) &&
+            ReadFile(file_, data, DWORD(n), &done, nullptr) && done == n;
+#else
+        return ::pread(file_, data, n, off_t(offset)) == ssize_t(n);
+#endif
+    }
+    SinkStatus trimLegacy() {
+        if (size_ <= kSegmentBytes) return SinkStatus::Ok;
+        // Bounded in-place tail repair of pre-fix oversized active logs: no
+        // temporary second segment, extra quota, or whole-file allocation.
+        const auto omitted = size_ - (kSegmentBytes - 128);
+        std::array<uint8_t, kRecordBytes> buffer{};
+        uint64_t from = omitted;
+        uint8_t byte{};
+        while (from < size_) {
+            if (!readAt(&byte, 1, from)) return SinkStatus::IoPartialReleased;
+            if ((byte & 0xc0) != 0x80) break;
+            ++from;
+        }
+        std::string marker = "[WARN] component=logger event=legacy_prefix_trimmed omitted_bytes=" + std::to_string(from) + "\n";
+        uint64_t to = marker.size();
+        if (!writeAt(reinterpret_cast<const uint8_t*>(marker.data()), marker.size(), 0)) return SinkStatus::IoPartialReleased;
+        while (from < size_) {
+            const size_t count = size_t(std::min<uint64_t>(buffer.size(), size_ - from));
+            if (!readAt(buffer.data(), count, from) || !writeAt(buffer.data(), count, to)) return SinkStatus::IoPartialReleased;
+            from += count; to += count;
+        }
+#ifdef _WIN32
+        LARGE_INTEGER end; end.QuadPart = to;
+        if (!SetFilePointerEx(file_, end, nullptr, FILE_BEGIN) || !SetEndOfFile(file_)) return SinkStatus::IoPartialReleased;
+#else
+        if (::ftruncate(file_, off_t(to))) return SinkStatus::IoPartialReleased;
+#endif
+        size_ = to; return SinkStatus::Ok;
+    }
+    SinkStatus rotate() {
+        if (!activeValid() || !closeActive()) return SinkStatus::IoPartialReleased;
+        std::vector<Entry> entries;
+        auto status = inventory(entries);
+        if (status != SinkStatus::Ok) return status;
+        uint64_t sequence = 0;
+        const auto stem = utf8(utf8Path(name_).stem());
+        const auto extension = utf8(utf8Path(name_).extension());
+        std::string history;
+        do {
+            if (++sequence == std::numeric_limits<uint64_t>::max()) return SinkStatus::Invalid;
+            history = stem + "_" + std::to_string(sequence) + extension;
+        } while (contains(entries, history));
+#ifdef _WIN32
+        if (!MoveFileW((parent_ / utf8Path(name_)).c_str(), (parent_ / utf8Path(history)).c_str())) return SinkStatus::IoNoOwner;
+#else
+        // linkat without AT_SYMLINK_FOLLOW cannot touch a substituted target;
+        // never replace an existing history segment. The active fd is closed.
+        if (::linkat(directory_, name_.c_str(), directory_, history.c_str(), 0) ||
+            ::unlinkat(directory_, name_.c_str(), 0)) return SinkStatus::IoNoOwner;
+#endif
+        entries.clear(); status = inventory(entries);
+        if (status != SinkStatus::Ok) return status;
+        status = prune(entries, kFileCount - 1);
+        return status == SinkStatus::Ok ? openActive() : status;
+    }
+    SinkStatus failedConfigure(SinkStatus original) {
+        return close() == SinkStatus::Ok ? original : SinkStatus::InternalUncertain;
+    }
+    SinkStatus failReleased(SinkStatus original) {
+        return close() == SinkStatus::Ok ?
+            (original == SinkStatus::UnsafePath ? original : SinkStatus::IoPartialReleased) : SinkStatus::InternalUncertain;
+    }
+};
+} // namespace tim2tox::diag
+#endif
