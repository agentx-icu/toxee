+    final buffer = pkgffi.malloc<ffi.Uint8>(bytes.isEmpty ? 1 : bytes.length);
+    try {
+      buffer.asTypedList(bytes.length).setAll(0, bytes);
+      return append(generation, buffer, bytes.length);
+    } finally {
+      pkgffi.malloc.free(buffer);
+    }
+  }
