+  /// no owner; it never closes an active managed or legacy sink.
+  int releaseLogOwned(int generation) =>
+      _lib.lookupFunction<_log_release_owned_c, int Function(int)>(
+          'tim2tox_ffi_log_release_owned')(generation);
+
