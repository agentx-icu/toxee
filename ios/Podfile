# Uncomment this line to define a global platform for your project
# mobile_scanner 6.x requires iOS 15.5+; bump the global platform to match.
platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # permission_handler_apple OPT-IN MACROS — REQUIRED, not optional.
    #
    # permission_handler_apple compiles every permission strategy out by
    # default: `Classes/PermissionHandlerEnums.h` does
    #   #ifndef PERMISSION_MICROPHONE
    #     #define PERMISSION_MICROPHONE 0
    #   #endif
    # for EVERY permission, and `AudioVideoPermissionStrategy.h` then falls back
    # to `@interface AudioVideoPermissionStrategy : UnknownPermissionStrategy`.
    # `UnknownPermissionStrategy.requestPermission:` unconditionally answers
    # `PermissionStatusPermanentlyDenied` WITHOUT ever asking iOS — so
    # `Permission.microphone.request()` returned permanentlyDenied on every iOS
    # build (device AND simulator) no matter what TCC said, and
    # `CallServiceManager._preflightOutgoingCall` /
    # `_ensurePermissionsForCurrentMode` aborted every voice/video call with
    # `CallSetupFailureReason.preflightDenied` before any tox_av signalling.
    # Verified on the pre-fix build: `otool -oV` on the built
    # permission_handler_apple.framework showed
    #   _OBJC_CLASS_$_AudioVideoPermissionStrategy
    #     superclass _OBJC_CLASS_$_UnknownPermissionStrategy
    #     baseMethods 0x0            <- no methods at all
    #
    # Only enable groups this app actually requests AND that have a matching
    # Info.plist usage string, because an enabled group with no usage string is
    # an immediate iOS termination when requested:
    #   PERMISSION_MICROPHONE -> NSMicrophoneUsageDescription   (calls, voice msgs)
    #   PERMISSION_CAMERA     -> NSCameraUsageDescription       (video calls, QR)
    #   PERMISSION_PHOTOS     -> NSPhotoLibraryUsageDescription +
    #                            NSPhotoLibraryAddUsageDescription (image picker,
    #                            also covers PermissionGroupPhotosAddOnly)
    # Android is unaffected (manifest-driven); macOS never asks
    # (CallPermissionHelper.shouldRequestRuntimePermission is false there).
    target.build_configurations.each do |config|
      defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
      defs = [defs] unless defs.is_a?(Array)
      defs |= [
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_CAMERA=1',
        'PERMISSION_PHOTOS=1',
      ]
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs
    end
  end
end
